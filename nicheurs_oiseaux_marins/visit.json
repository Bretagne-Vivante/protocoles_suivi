{
  "genre":"M",
  "label": "Passage",
  "label_list": "Passages",
  "display_properties": [
    "id_dataset",
    "observers",
    "num_passage",
    "visit_date_min",
    "accessibility",
    "pluviosite",
    "couverture_nuageuse",
    "vent",
    "occupation",
    "comments"
  ],
  "display_list": [
    "num_passage",
    "visit_date_min",
    "observers",
    "nb_observations"
  ],
  "keep": [
    "observers",
    "visit_date_min",
    "accessibility",
    "pluviosite",
    "couverture_nuageuse",
    "vent",
    "comments"
  ],
  "specific": {
    "id_base_site": {
      "type_widget": "site",
      "required": true,
      "attribut_label": "Nid"
    },
    "num_passage": {
      "type_widget": "number",
      "required": true,
      "attribut_label": "Numéro de passage",
      "min": 1,
      "value": 0    
    },
    "visit_date_min": {
      "type_widget": "date",
      "attribut_label": "Date du passage",
      "required": true
    },
    "accessibility": {
       "type_widget": "radio",
       "required": true,
       "attribut_label": "Le nid est accessible",
       "values": ["Oui", "Non"],
       "value": "Oui"
    },
    "pluviosite": {
      "type_widget": "nomenclature",
      "attribut_label": "Pluviosité",
      "code_nomenclature_type": "PLUVIOSITE",
	    "required": false,
      "type_util": "nomenclature", 
      "hidden":"({value}) => value.accessibility === 'Non'"
    },
    "couverture_nuageuse": {
      "type_widget": "nomenclature",
      "attribut_label": "Couverture nuageuse",
      "code_nomenclature_type": "COUVERTURE_NUAGEUSE",
	    "required": false,
      "type_util": "nomenclature",
      "hidden":"({value}) => value.accessibility === 'Non'"
    },
    "vent": {
      "type_widget": "nomenclature",
      "attribut_label": "Vent",
      "code_nomenclature_type": "VENT",
      "required": false,
      "type_util": "nomenclature" ,
      "hidden":"({value}) => value.accessibility === 'Non'"   
    },
    "comments": {
      "type_widget": "textarea",
      "attribut_label": "Commentaire"
    },
    "occupation": {
      "type_widget": "radio",
      "required": true,
      "attribut_label": "Le site est apparemment occupé",
      "values": ["Oui", "Non"],
      "value": "Oui",
      "hidden":"({value}) => value.accessibility === 'Non'"   
   }, 
    "nb_observations": {
      "attribut_label": "Nb. d'observations"
    }
  }
}
